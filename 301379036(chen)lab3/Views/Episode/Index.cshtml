@model IEnumerable<_301379036_chen_lab3.Models.EpisodeModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
        <form asp-action="Index" method="get">
            <div>
                <label>Topic:</label>
                <input type="text" name="searchTopic" />

                <label>Host:</label>
                <input type="text" name="searchHost" />

                <button type="submit">Search</button>
            </div>
        </form>
<table class="table">
    <thead>
        <tr>
            <th>
                Podcast
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                <a asp-action="ByDate">
                @Html.DisplayNameFor(model => model.ReleaseDate)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Duration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlayCount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AudioFileURL)
            </th>
            @if (User.IsInRole("Admin"))
            {
            <th>
                @Html.DisplayNameFor(model => model.IsApproved)
            </th>    
            }
            <th>
                Actions
            </th>
            <th>
                <a asp-action="ByPopular">
                    View Popular Episodes
                </a>
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @item.Podcast?.Title
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Duration)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PlayCount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AudioFileURL)
            </td>
            @if (User.IsInRole("Admin"))
            {
                <td>
                    @Html.DisplayFor(modelItem => item.IsApproved)
                </td>
			}
            <td>
                <a asp-action="Edit" asp-route-id="@item.EpisodeId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EpisodeId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EpisodeId">Delete</a>
                    @if (User.IsInRole("Admin") ){
                        if (!item.IsApproved)
                        {
                            <form asp-controller = "Admin" asp-action="ApproveEpisode" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.EpisodeId" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    Approve
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                    }
                </td>
        </tr>
}
    </tbody>
</table>
